# MOKED environment
# Copy to .env.local and fill for live Meta Cloud API.

# Demo mode works without these — use "חבר WhatsApp (דמו)" in onboarding.
META_APP_ID=
META_APP_SECRET=
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_WHATSAPP_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=moked_dev_verify_token

# Optional: when live Embedded Signup exchanges a code for a token
META_REDIRECT_URI=
