# MOKED environment
# Copy to .env.local

# --- Auth (like Fixly) ---
# Comma-separated superadmin emails
ADMIN_EMAILS=you@example.com
# Local bootstrap password for first ADMIN_EMAILS entry (dev only)
ADMIN_BOOTSTRAP_PASSWORD=moked-admin-change-me
AUTH_SECRET=change-me-in-production
# Password for https://moked-ten.vercel.app/admin. Server only — never commit the real value.
ADMIN_GATE_PASSWORD=

# Neon Postgres. When set, the app stores tenants, conversations, and logins here.
# Server only — never expose to the browser / never commit.
DATABASE_URL=

# SaaS fees shown to the business (ILS). Never hardcode in UI — read via product/model.
MOKED_SETUP_FEE_ILS=690
MOKED_SUBSCRIPTION_ILS=299
MOKED_ANNUAL_ILS=2990
# First ten customers: setup waived for testimonial + reference; invoiced manually (post go-live checkout).
# When set, POST /api/billing/webhook must send x-moked-signature = hex hmac sha256 of the raw body.
BILLING_WEBHOOK_SECRET=
# Protects GET /api/cron/reminders. Vercel Cron sends it as Authorization: Bearer.
CRON_SECRET=
MOKED_BILLING_PROVIDER=
# Wave D customer payment links (parked for trades beachhead v1).
MOKED_ENABLE_CUSTOMER_PAYMENTS=false

# Pool registration. Without these, numbers stay reserved and are not sent to Meta.
META_WABA_ID=
META_SYSTEM_USER_TOKEN=
# Inbound SMS from 019. Header x-019-token must match.
O19_SMS_WEBHOOK_SECRET=

# Optional LLM. Demo / eval use the deterministic classifier with no key and no cost.
MOKED_LLM_API_KEY=
MOKED_LLM_MODEL=gpt-4o-mini
MOKED_AGENT_ENABLED=true
MOKED_AGENT_CONFIDENCE_REPLY=0.75
MOKED_AGENT_CONFIDENCE_CLARIFY=0.45
MOKED_AGENT_MAX_TURNS=6
MOKED_AGENT_MAX_COST_ILS=0.35
MOKED_AGENT_DRY_RUN=false

# Supabase (optional legacy). Ignored for data when DATABASE_URL is set.
NEXT_PUBLIC_SUPABASE_URL=
# Prefer NEXT_PUBLIC_*; SUPABASE_ANON_KEY also accepted (Vercel without PUBLIC)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_ANON_KEY=
# Server only — never expose to the browser / never commit
SUPABASE_SERVICE_ROLE_KEY=

# --- Meta WhatsApp Cloud API (live product) ---
META_APP_ID=
META_APP_SECRET=
META_EMBEDDED_SIGNUP_CONFIG_ID=
# Optional fallback token; live tenants prefer per-tenant token from Embedded Signup
META_WHATSAPP_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=moked_dev_verify_token
META_REDIRECT_URI=

# --- URLs ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_LANDING_URL=http://localhost:3001
NEXT_PUBLIC_PILOT_WHATSAPP=972548102688
