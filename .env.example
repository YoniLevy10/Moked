# MOKED environment
# Copy to .env.local

# --- Auth (like Fixly) ---
# Comma-separated superadmin emails
ADMIN_EMAILS=you@example.com
# Local bootstrap password for first ADMIN_EMAILS entry (dev only)
ADMIN_BOOTSTRAP_PASSWORD=moked-admin-change-me
AUTH_SECRET=change-me-in-production
# Password for https://moked-ten.vercel.app/admin. Server only — never commit the real value.
ADMIN_GATE_PASSWORD=

# Neon Postgres. When set, the app stores tenants, conversations, and logins here.
# Server only — never expose to the browser / never commit.
DATABASE_URL=

# Monthly subscription price shown to the business, in ILS.
MOKED_SUBSCRIPTION_ILS=249
# demo (default) keeps local URLs and DemoPspClient. live uses a real PspClient adapter.
MOKED_PROVIDER_MODE=demo
# Which live PSP adapter to use for SaaS billing: tranzila | grow | payplus | cardcom | demo
# Only tranzila is implemented today; others throw until their adapter ships.
MOKED_BILLING_PROVIDER=demo
# Shared HMAC secret for PSP notify webhooks (x-moked-signature = hex hmac-sha256 of raw body).
# Replaces BILLING_WEBHOOK_SECRET. TRANZILA_WEBHOOK_SECRET is accepted as a legacy alias.
PSP_WEBHOOK_SECRET=
# Protects GET /api/cron/reminders. Vercel Cron sends it as Authorization: Bearer.
CRON_SECRET=

# --- PSP adapters (server only) ---
# Tranzila — first live PspClient implementation. Unused when MOKED_PROVIDER_MODE=demo.
TRANZILA_API_URL=
TRANZILA_TERMINAL=
TRANZILA_API_KEY=
TRANZILA_API_SECRET=
TRANZILA_HOSTED_BASE_URL=
TRANZILA_TOKEN_URL=
TRANZILA_NOTIFY_URL=
# Legacy alias for PSP_WEBHOOK_SECRET (optional)
TRANZILA_WEBHOOK_SECRET=

# Pool registration. Without these, numbers stay reserved and are not sent to Meta.
META_WABA_ID=
META_SYSTEM_USER_TOKEN=
# Inbound SMS from 019. Header x-019-token must match.
O19_SMS_WEBHOOK_SECRET=

# Optional. The process engine answers without this. Used only if a later model pass is turned on.
MOKED_LLM_API_KEY=
MOKED_LLM_MODEL=gpt-4o-mini

# Supabase (optional legacy). Ignored for data when DATABASE_URL is set.
NEXT_PUBLIC_SUPABASE_URL=
# Prefer NEXT_PUBLIC_*; SUPABASE_ANON_KEY also accepted (Vercel without PUBLIC)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_ANON_KEY=
# Server only — never expose to the browser / never commit
SUPABASE_SERVICE_ROLE_KEY=

# --- Meta WhatsApp Cloud API (live product) ---
META_APP_ID=
META_APP_SECRET=
META_EMBEDDED_SIGNUP_CONFIG_ID=
# Optional fallback token; live tenants prefer per-tenant token from Embedded Signup
META_WHATSAPP_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=moked_dev_verify_token
META_REDIRECT_URI=
# Local-only Meta signature bypass (never set in production)
MOKED_META_SIGNATURE_BYPASS=
META_TEMPLATE_SUBMIT_ENABLED=

# --- URLs ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_LANDING_URL=http://localhost:3001
NEXT_PUBLIC_PILOT_WHATSAPP=972548102688
